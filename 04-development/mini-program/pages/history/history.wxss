/**
 * JD 说真话 - 历史记录页样式
 */

/* ==================== 加载动画 ==================== */

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #FFE0E8;
  border-top-color: #FF2D55;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* ==================== 重试区域 ==================== */

.retry-area {
  margin-top: 24rpx;
}

.retry-text {
  font-size: 28rpx;
  color: #FF2D55;
}

/* ==================== 空状态 ==================== */

.empty-hint {
  font-size: 24rpx;
  color: #C0C0D0;
  margin-top: 12rpx;
  margin-bottom: 40rpx;
}

.go-parse-btn {
  width: 300rpx;
}

/* ==================== 历史记录卡片 ==================== */

.history-card {
  display: flex;
  flex-direction: column;
  transition: all 0.2s ease;
}

.history-card:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.category-badge {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 20rpx;
  background-color: #FFF0F3;
  color: #FF2D55;
  border-radius: 6rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.history-time {
  font-size: 22rpx;
  color: #C0C0D0;
}

/* ==================== JD 摘要 ==================== */

.history-summary {
  margin-bottom: 16rpx;
}

.summary-text {
  font-size: 28rpx;
  color: #333348;
  line-height: 1.7;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ==================== 卡片底部 ==================== */

.history-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.history-score {
  display: flex;
  align-items: center;
}

.score-star {
  font-size: 28rpx;
  color: #FF2D55;
  margin-right: 4rpx;
}

.view-detail {
  font-size: 24rpx;
  color: #FF2D55;
}

/* ==================== 加载更多 ==================== */

.load-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 32rpx 0;
}

.load-more-text {
  font-size: 24rpx;
  color: #C0C0D0;
}
