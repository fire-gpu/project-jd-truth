<!--
  JD 说真话 - 历史记录页
  布局：列表展示历史记录，空状态提示
-->

<view class="page-container">

  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 加载失败 -->
  <view class="empty-container" wx:elif="{{loadError}}">
    <text class="empty-icon">!</text>
    <text class="empty-text">{{loadError}}</text>
    <view class="retry-area">
      <text class="retry-text" bindtap="loadHistory">点击重试</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-container" wx:elif="{{isEmpty}}">
    <text class="empty-icon">&#x1F4CB;</text>
    <text class="empty-text">还没有解读记录</text>
    <text class="empty-hint">去首页粘贴一份 JD，开始你的第一次解读吧</text>
    <button class="btn-primary go-parse-btn" bindtap="goToIndex">去解读</button>
  </view>

  <!-- 历史记录列表 -->
  <block wx:else>

    <view
      wx:for="{{historyList}}"
      wx:key="id"
      class="history-card card"
      data-id="{{item.id}}"
      bindtap="goToDetail"
    >
      <!-- 卡片头部：岗位类别 + 时间 -->
      <view class="history-header">
        <view class="category-badge">{{item.jobCategoryName || item.jobCategory || '未分类'}}</view>
        <text class="history-time">{{item.createdAt || ''}}</text>
      </view>

      <!-- JD 摘要 -->
      <view class="history-summary">
        <text class="summary-text">{{item.jdSummary || item.jdText || '无内容'}}</text>
      </view>

      <!-- 卡片底部：评分 + 查看提示 -->
      <view class="history-footer">
        <view class="history-score" wx:if="{{item.score}}">
          <text class="score-star" wx:for="{{[1,2,3,4,5]}}" wx:for-item="star" wx:key="*this">
            {{item.score >= star ? '&#9733;' : '&#9734;'}}
          </text>
        </view>
        <text class="view-detail">查看详情 ></text>
      </view>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{loadingMore}}">
      <text class="load-more-text">加载更多...</text>
    </view>

    <!-- 没有更多 -->
    <view class="load-more" wx:elif="{{!hasMore && historyList.length > 0}}">
      <text class="load-more-text">没有更多了</text>
    </view>

  </block>

</view>
