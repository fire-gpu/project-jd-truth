/**
 * JD 说真话 - 报告页样式
 */

/* ==================== 加载动画 ==================== */

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #FFE0E8;
  border-top-color: #FF2D55;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* ==================== 骨架屏 ==================== */

.skeleton {
  padding: 32rpx;
}

.skeleton-title {
  width: 60%;
  height: 48rpx;
  background: linear-gradient(90deg, #F0F0F0 25%, #E8E8E8 50%, #F0F0F0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: 12rpx;
  margin-bottom: 40rpx;
}

.skeleton-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(255,45,85,0.06);
}

.skeleton-line {
  height: 28rpx;
  background: linear-gradient(90deg, #F0F0F0 25%, #E8E8E8 50%, #F0F0F0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.skeleton-line.long { width: 90%; }
.skeleton-line.medium { width: 70%; }
.skeleton-line.short { width: 45%; }

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ==================== 重试按钮 ==================== */

.retry-btn {
  margin-top: 40rpx;
  width: 300rpx;
}

/* ==================== 报告标题区 ==================== */

.report-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.report-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A2E;
}

.report-time {
  font-size: 24rpx;
  color: #8888A0;
}

/* ==================== 维度分组 ==================== */

.report-section-group {
  margin-bottom: 32rpx;
}

.group-label {
  font-size: 24rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: 6rpx;
  margin-bottom: 16rpx;
  display: inline-block;
}

.group-label-core {
  background-color: #FFF0F3;
  color: #FF2D55;
}

.group-label-extended {
  background-color: #FFF0F3;
  color: #FF8FA3;
}

.group-label-personal {
  background-color: #FFF0F3;
  color: #FF2D55;
}

/* ==================== Rich-text 内容样式 ==================== */

.rich-text-content {
  width: 100%;
}

/* 报告区块 */
.report-section {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(255, 45, 85, 0.06);
  padding: 28rpx;
  margin-bottom: 20rpx;
}

/* 核心维度区块 */
.section-core {
  border-left: 8rpx solid #FF2D55;
}

/* 扩展维度区块 */
.section-extended {
  border-left: 6rpx solid #FF8FA3;
}

/* 个性化维度区块 */
.section-personal {
  border-left: 8rpx solid #FF2D55;
  background-color: #FFF0F3;
}

/* 区块头部 */
.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
}

/* 区块内容 */
.section-body {
  font-size: 28rpx;
  color: #333348;
  line-height: 1.8;
}

/* Markdown 渲染样式 */
.md-h3 {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin: 20rpx 0 12rpx;
}

.md-h4 {
  font-size: 28rpx;
  font-weight: 600;
  color: #333348;
  margin: 16rpx 0 8rpx;
}

.md-paragraph {
  margin: 8rpx 0;
  line-height: 1.8;
}

.md-list-item {
  display: flex;
  align-items: flex-start;
  margin: 8rpx 0;
  line-height: 1.8;
}

.md-bullet {
  color: #FF2D55;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.md-num-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  background-color: #FFF0F3;
  color: #FF2D55;
  border-radius: 50%;
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 12rpx;
  flex-shrink: 0;
}

strong {
  font-weight: 600;
  color: #1A1A2E;
}

/* ==================== 数据来源声明 ==================== */

.source-notice {
  background-color: #FFF8FA;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.source-text {
  font-size: 22rpx;
  color: #8888A0;
  line-height: 1.6;
}

/* ==================== 反馈评分区 ==================== */

.feedback-card {
  margin-bottom: 24rpx;
}

.score-area {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.star {
  margin-right: 16rpx;
  padding: 8rpx;
}

.star-icon {
  font-size: 48rpx;
  color: #D9D9D9;
}

.star-active .star-icon {
  color: #FF2D55;
}

.score-text {
  font-size: 26rpx;
  color: #8888A0;
  margin-left: 12rpx;
}

.feedback-input {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx;
  background-color: #FFF8FA;
  border: 2rpx solid #FFE0E8;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333348;
  line-height: 1.7;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.feedback-btn {
  margin-top: 8rpx;
}

/* 已提交反馈 */
.feedback-thanks {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.thanks-text {
  font-size: 26rpx;
  color: #FF2D55;
  text-align: center;
}

/* ==================== 底部操作 ==================== */

.bottom-actions {
  padding: 16rpx 0 48rpx;
  padding-bottom: 160rpx;
}

.re-parse-btn {
  margin-top: 0;
}

/* ==================== 底部悬浮操作栏 ==================== */

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.bottom-bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 22rpx;
  color: #666680;
  padding: 8rpx 24rpx;
  background: transparent;
  border: none;
  line-height: normal;
  margin: 0;
}

/* 重置 button 默认样式 */
.bottom-bar-item::after {
  border: none;
}

.bottom-bar-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}

.bottom-bar-primary {
  color: #FF2D55;
  font-weight: 600;
}

.bottom-bar-primary .bottom-bar-icon {
  color: #FF2D55;
}
